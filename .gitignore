__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/

# macOS junk (was getting committed)
.DS_Store

# LaTeX build artifacts: keep the .tex and the .pdf, drop the rest.
# Scoped to docs/ so it can never touch results/runs/*/console.log.
docs/*.aux
docs/*.log
docs/*.out
docs/*.synctex.gz

# results: keep the folder, ignore the heavy outputs
results/*
!results/.gitkeep
# ...but track each run's tiny meta.json (the numbers + provenance you compare
# across machines). Heavy .npy/.png artifacts stay ignored and are regenerable.
# Re-include the runs tree's directories at every depth (never leave a parent
# excluded, or the file re-include below can't take effect), then the one file.
!results/runs/
results/runs/**
!results/runs/**/
!results/runs/**/meta.json

# Third-party datasets fetched at setup, not ours to redistribute.
# Anchored with a leading slash so it matches the top-level data/ ONLY and never
# src/dprobe/data/, which is the package.
#   data/roleplaying/dataset.yaml  <- Apollo, github.com/ApolloResearch/deception-detection
/data/

# generated by src/dprobe/scheming/*: the parsed MCQ jsonl and the model's
# choices. Both are regenerable from dataset.yaml plus the scripts, and the
# jsonl is a derivative of Apollo's data, which /data/ already excludes.
/runs/
data/roleplaying/dataset_mcq.jsonl

# model/activation caches
*.npy
.cache/
~/.cache/huggingface/

# private local notes for Claude Code, not for the team
CLAUDE.local.md
.env
# .claude/ is private EXCEPT docs/ (ADRs etc.) which the team versions.
# `.claude/*` not `.claude/`: an excluded DIRECTORY can't have children re-included.
.claude/*
!.claude/docs/